{
  "name": "jbrow",
  "productName": "jbrow",
  "version": "0.1.1",
  "description": "A browser that isn't there until you call it.",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "Vladimir 'join3r' Schmotzer",
  "main": "dist/main.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "node scripts/patch-deps.mjs && node build.mjs",
    "start": "npm run setup && electron .",
    "dev": "npm run setup && JBROW_DEBUG=1 electron .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/run.mjs",
    "test:unit": "node test/run.mjs unit",
    "test:linux": "test/linux/run.sh",
    "dist": "npm run setup && electron-builder --mac",
    "top-sites": "node scripts/top-sites.mjs",
    "urlbar-shots": "node scripts/urlbar-shots.mjs",
    "icon": "sips -s format png build/icon.svg --out build/icon.png",
    "install-app": "scripts/install.sh",
    "release": "scripts/release.sh"
  },
  "dependencies": {
    "electron-chrome-extensions": "4.9.0",
    "electron-chrome-web-store": "0.13.0",
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "@types/node": "22.19.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "sk.awantech.jbrow",
    "productName": "jbrow",
    "copyright": "© Vladimir Schmotzer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": true,
        "NSCameraUsageDescription": "A site you visit wants to use the camera. jbrow asks you first.",
        "NSMicrophoneUsageDescription": "A site you visit wants to use the microphone. jbrow asks you first.",
        "NSLocationUsageDescription": "A site you visit wants your location. jbrow asks you first.",
        "NSLocationWhenInUseUsageDescription": "A site you visit wants your location. jbrow asks you first.",
        "NSBluetoothAlwaysUsageDescription": "A site you visit wants to use a Bluetooth device."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "maintainer": "Vladimir Schmotzer <join3r@gmail.com>",
      "synopsis": "A browser that isn't there until you call it."
    },
    "publish": {
      "provider": "github",
      "owner": "join3r",
      "repo": "jbrow",
      "releaseType": "draft"
    },
    "protocols": [
      {
        "name": "Web site URL",
        "schemes": [
          "http",
          "https"
        ],
        "role": "Viewer"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm",
          "xhtml",
          "shtml"
        ],
        "name": "HTML document",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "grantFileProtocolExtraPrivileges": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "asarUnpack": [
      "dist/ui/**"
    ]
  }
}
